{
  "name": "prescripts",
  "version": "0.1.0",
  "description": "Static lifecycle script scanner for npm dependencies — triage tool for humans and LLM agents",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "prescripts": "./dist/src/index.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:mcp": "tsx mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "14.0.3",
    "p-limit": "7.3.0",
    "p-retry": "8.0.0",
    "simple-git": "3.35.2",
    "tar": "7.5.13",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "@types/yauzl": "^2.10.3",
    "tsx": "4.22.4",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  },
  "keywords": [
    "npm",
    "security",
    "supply-chain",
    "lifecycle-scripts",
    "static-analysis",
    "mcp"
  ],
  "license": "MIT"
}
